        "description": "每选定构建×质量KPI；构建级，不受岗位/城市切片影响。",
        "lineageTag": "a54314aa-d15f-43ef-9438-098742dbd6df",
        "measures": [
          {
            "name": "KPI分子",
            "description": "项目运营验收条件；跨KPI不计算无意义总计。",
            "expression": "IF(HASONEVALUE(QualityKpi[kpi_code]),SUM(QualityKpi[numerator]))",
            "formatString": "#,0",
            "lineageTag": "cfb1aa57-febc-49c9-a5eb-94cea7d16bc1"
          },
          {
            "name": "KPI分母",
            "description": "项目运营验收条件；跨KPI不计算无意义总计。",
            "expression": "IF(HASONEVALUE(QualityKpi[kpi_code]),SUM(QualityKpi[denominator]))",
            "formatString": "#,0",
            "lineageTag": "2654afc4-b9bd-4465-91dd-369a9f947c2b"
          },
          {
            "name": "KPI实际值",
            "description": "项目运营验收条件；跨KPI不计算无意义总计。",
            "expression": "DIVIDE([KPI分子],[KPI分母])",
            "formatString": "0.0%",
            "lineageTag": "7ddf9455-537a-4d80-9b27-1dfb122fe4a2"
          },
          {
            "name": "KPI目标值",
            "description": "项目运营验收条件；跨KPI不计算无意义总计。",
            "expression": "IF(HASONEVALUE(QualityKpi[kpi_code]),MAX(QualityKpi[goal_value]))",
            "formatString": "0.0%",
            "lineageTag": "95fe89ae-843a-4cfd-bcbe-e8e952f4e1a2"
          },
          {
            "name": "KPI状态说明",
            "description": "项目运营验收条件；跨KPI不计算无意义总计。",
            "expression": "IF(NOT HASONEVALUE(QualityKpi[kpi_code]),BLANK(),IF(ISBLANK([KPI实际值]),\"无分母\",IF([KPI实际值]>=[KPI目标值],\"达标\",\"未达标\")))",
            "lineageTag": "214b59aa-2d05-4b2a-b2b6-e33b87282b5f"
          },
          {
            "name": "KPI趋势说明",
            "description": "项目运营验收条件；跨KPI不计算无意义总计。",
            "expression": "IF(HASONEVALUE(QualityKpi[kpi_code]),\"无可比日序列\")",
            "lineageTag": "3647eb1e-bf15-4ece-aced-6e7bf08371fd"
          }
        ],
        "partitions": [
          {
            "name": "QualityKpi",
            "mode": "import",
            "source": {
              "expression": "Odbc.Query(\"driver={ODBC Driver 18 for SQL Server};server=lpc:localhost;database=recruitment_dw_dev_expansion_v1;encrypt=yes;trustservercertificate=yes;\", \"SELECT * FROM ads.cd_quality_kpi WHERE build_id IN (7,5,4,6)\")",
              "type": "m"
            }
          }
        ]
