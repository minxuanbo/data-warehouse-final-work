          {
            "name": "city",
            "dataType": "string",
            "lineageTag": "7bec3c23-a2b1-44fb-808e-054765bc3549",
            "sourceColumn": "city",
            "summarizeBy": "none"
          }
        ],
        "isHidden": true,
        "lineageTag": "f1d46226-d49f-4f8a-aca7-295336e00fc6",
        "partitions": [
          {
            "name": "CityJobs",
            "mode": "import",
            "source": {
              "expression": [
                "Odbc.Query(\"driver={ODBC Driver 18 for SQL Server};server=lpc:localhost;database=recruitment_dw_dev_cd_v1;encrypt=yes;trustservercertificate=yes;\", \"SELECT DISTINCT CONCAT(j.build_id,'|',j.source_job_id) AS job_key,",
                "          CASE WHEN j.location_conflict=1 THEN N'冲突待确认'",
                "            WHEN RIGHT(loc.value,1)=N'市' THEN LEFT(loc.value,LEN(loc.value)-1)",
                "            ELSE COALESCE(NULLIF(loc.value,N''),N'未知') END AS city",
                "          FROM (SELECT * FROM ads.cd_job_detail WHERE build_id IN (11,10)) j OUTER APPLY OPENJSON(j.confirmed_locations_json) loc\")"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "SkillJobs",
        "columns": [
