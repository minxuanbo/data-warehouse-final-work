        "description": "每选定构建×质量KPI；构建级，不受岗位/城市切片影响。",
        "lineageTag": "c2d51b80-ebe8-43e5-9448-3303de93e283",
        "measures": [
          {
            "name": "KPI分子",
            "description": "项目运营验收条件；跨KPI不计算无意义总计。",
            "expression": "IF(HASONEVALUE(QualityKpi[kpi_code]),SUM(QualityKpi[numerator]))",
            "formatString": "#,0",
            "lineageTag": "ffc505f9-3b79-4d2c-9a3f-3deaec281648"
          },
          {
            "name": "KPI分母",
            "description": "项目运营验收条件；跨KPI不计算无意义总计。",
            "expression": "IF(HASONEVALUE(QualityKpi[kpi_code]),SUM(QualityKpi[denominator]))",
            "formatString": "#,0",
            "lineageTag": "0c773143-7863-44f4-94e7-9c3638071edc"
          },
          {
            "name": "KPI实际值",
            "description": "项目运营验收条件；跨KPI不计算无意义总计。",
            "expression": "DIVIDE([KPI分子],[KPI分母])",
            "formatString": "0.0%",
            "lineageTag": "a8956ceb-292a-4206-a927-6df0d3258cea"
          },
          {
            "name": "KPI目标值",
            "description": "项目运营验收条件；跨KPI不计算无意义总计。",
            "expression": "IF(HASONEVALUE(QualityKpi[kpi_code]),MAX(QualityKpi[goal_value]))",
            "formatString": "0.0%",
            "lineageTag": "da2e1925-fc09-43fc-a82a-6587558ce23a"
          },
          {
            "name": "KPI状态说明",
            "description": "项目运营验收条件；跨KPI不计算无意义总计。",
            "expression": "IF(NOT HASONEVALUE(QualityKpi[kpi_code]),BLANK(),IF(ISBLANK([KPI实际值]),\"无分母\",IF([KPI实际值]>=[KPI目标值],\"达标\",\"未达标\")))",
            "lineageTag": "a77cdf6d-a35f-4b4a-a66c-b633af07b693"
          },
          {
            "name": "KPI趋势说明",
            "description": "项目运营验收条件；跨KPI不计算无意义总计。",
            "expression": "IF(HASONEVALUE(QualityKpi[kpi_code]),\"无可比日序列\")",
            "lineageTag": "a165876c-387e-4baa-a96b-e3da44b2c807"
          }
        ],
        "partitions": [
          {
