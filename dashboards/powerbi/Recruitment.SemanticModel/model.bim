        "description": "每选定构建×质量KPI；构建级，不受岗位/城市切片影响。",
        "lineageTag": "714cf981-e0f0-4081-be6d-58120db6f071",
        "measures": [
          {
            "name": "KPI分子",
            "description": "项目运营验收条件；跨KPI不计算无意义总计。",
            "expression": "IF(HASONEVALUE(QualityKpi[kpi_code]),SUM(QualityKpi[numerator]))",
            "formatString": "#,0",
            "lineageTag": "5abf914b-bf5d-42b4-a997-cf5795cac7cf"
          },
          {
            "name": "KPI分母",
            "description": "项目运营验收条件；跨KPI不计算无意义总计。",
            "expression": "IF(HASONEVALUE(QualityKpi[kpi_code]),SUM(QualityKpi[denominator]))",
            "formatString": "#,0",
            "lineageTag": "347b312f-61e5-4866-91a7-d21e396f62b7"
          },
          {
            "name": "KPI实际值",
            "description": "项目运营验收条件；跨KPI不计算无意义总计。",
            "expression": "DIVIDE([KPI分子],[KPI分母])",
            "formatString": "0.0%",
            "lineageTag": "2019eb20-9551-4fe4-86d6-f33699488d2e"
          },
          {
            "name": "KPI目标值",
            "description": "项目运营验收条件；跨KPI不计算无意义总计。",
            "expression": "IF(HASONEVALUE(QualityKpi[kpi_code]),MAX(QualityKpi[goal_value]))",
            "formatString": "0.0%",
            "lineageTag": "8e5542eb-afcc-4da0-b8c2-b874f0f4838c"
          },
          {
            "name": "KPI状态说明",
            "description": "项目运营验收条件；跨KPI不计算无意义总计。",
            "expression": "IF(NOT HASONEVALUE(QualityKpi[kpi_code]),BLANK(),IF(ISBLANK([KPI实际值]),\"无分母\",IF([KPI实际值]>=[KPI目标值],\"达标\",\"未达标\")))",
            "lineageTag": "9de73978-bb27-4423-a11d-8522a0e57221"
          },
          {
            "name": "KPI趋势说明",
            "description": "项目运营验收条件；跨KPI不计算无意义总计。",
            "expression": "IF(HASONEVALUE(QualityKpi[kpi_code]),\"无可比日序列\")",
            "lineageTag": "e1b7e4a2-f231-4fb1-a38c-05c4bc2067a0"
          }
        ],
        "partitions": [
