        "description": "固定历史CD构建的来源岗位投影；source_category_group是官网原类别，不是标准岗位类别。",
        "lineageTag": "c32a405a-d96a-46b2-9e26-8c0f41fe58b4",
        "measures": [
          {
            "name": "核心岗位数",
            "expression": "VAR K = VALUES(CityJobs[job_key]) RETURN COALESCE(CALCULATE(DISTINCTCOUNT(Jobs[job_key]), KEEPFILTERS(Jobs[is_core] = TRUE()), TREATAS(K, Jobs[job_key])),0)",
            "formatString": "#,0",
            "lineageTag": "21da07bd-3a9d-4da6-8f7a-d64c21dfcc39"
          },
          {
            "name": "正文分母",
            "expression": "VAR K = VALUES(CityJobs[job_key]) RETURN COALESCE(CALCULATE(DISTINCTCOUNT(Jobs[job_key]), KEEPFILTERS(Jobs[is_core] = TRUE()), TREATAS(K, Jobs[job_key]), KEEPFILTERS(Jobs[body_valid] = TRUE())),0)",
            "formatString": "#,0",
            "lineageTag": "e67b34a5-f7b2-43fd-8536-3d71d00208ea"
          },
          {
            "name": "正文覆盖率",
            "expression": "DIVIDE([正文分母],[核心岗位数])",
            "formatString": "0.0%",
            "lineageTag": "8b105f52-360b-46d6-8f8c-093c779eeb27"
          },
          {
            "name": "技能岗位数",
            "expression": "VAR K = VALUES(CityJobs[job_key]) RETURN COALESCE(CALCULATE(DISTINCTCOUNT(SkillJobs[job_key]), KEEPFILTERS(Jobs[is_core] = TRUE()), TREATAS(K, Jobs[job_key]), KEEPFILTERS(Jobs[body_valid] = TRUE())),0)",
            "formatString": "#,0",
            "lineageTag": "4935f188-ead9-4496-af71-3a1ebee5e612"
          },
          {
            "name": "岗位技能对数",
            "expression": "VAR K = VALUES(CityJobs[job_key]) RETURN COALESCE(CALCULATE(COUNTROWS(SkillJobs), KEEPFILTERS(Jobs[is_core] = TRUE()), TREATAS(K, Jobs[job_key]), KEEPFILTERS(Jobs[body_valid] = TRUE())),0)",
            "formatString": "#,0",
            "lineageTag": "0e59cd52-6bf3-4919-8513-e76a53af5866"
          },
          {
            "name": "技能出现占比",
            "expression": "DIVIDE([技能岗位数],[正文分母])",
            "formatString": "0.0%",
            "lineageTag": "43565b8f-f83e-467b-b785-aa86de6449b1"
          },
          {
            "name": "组合岗位数",
            "expression": "VAR K = VALUES(CityJobs[job_key]) RETURN COALESCE(CALCULATE(DISTINCTCOUNT(Pairs[job_key]), KEEPFILTERS(Jobs[is_core] = TRUE()), TREATAS(K, Jobs[job_key]), KEEPFILTERS(Jobs[body_valid] = TRUE())),0)",
            "formatString": "#,0",
            "lineageTag": "d587f061-1212-4144-a51b-c251eedf1204"
          },
          {
            "name": "组合出现占比",
            "expression": "DIVIDE([组合岗位数],[正文分母])",
            "formatString": "0.0%",
            "lineageTag": "201480db-b2ca-4bec-98a5-75d4569b18f3"
          },
          {
            "name": "有效证据数",
            "expression": "VAR K = VALUES(CityJobs[job_key]) RETURN COALESCE(CALCULATE(COUNTROWS(Evidence), KEEPFILTERS(Jobs[is_core] = TRUE()), TREATAS(K, Jobs[job_key]), KEEPFILTERS(Jobs[body_valid] = TRUE()), KEEPFILTERS(Evidence[eligible_for_metric]=TRUE())),0)",
            "formatString": "#,0",
            "lineageTag": "788bbd42-c623-4761-b8ef-5fc8982c6d7f"
          },
          {
            "name": "审计证据数",
            "expression": "VAR K = VALUES(CityJobs[job_key]) RETURN COALESCE(CALCULATE(COUNTROWS(Evidence), TREATAS(K, Jobs[job_key])),0)",
            "formatString": "#,0",
            "lineageTag": "d91ff7c4-a82e-4f85-a82c-ec7e6a25b0eb"
          },
          {
            "name": "本岗核心指标资格",
            "expression": "IF(SELECTEDVALUE(Jobs[is_core],FALSE()),\"核心\",\"扩展\")",
            "lineageTag": "81a074b3-bd46-43d1-8c3a-ffc0fc311954"
          },
          {
            "name": "样本说明",
            "expression": "\"两来源 partial 小批；观察日期不同；来源岗位计数；不用于全市场或趋势推断\"",
            "lineageTag": "48efb3b8-8b7e-4653-977f-f1798f69227d"
          }
        ],
        "partitions": [
          {
            "name": "Jobs",
            "mode": "import",
            "source": {
              "expression": [
                "Odbc.Query(\"driver={ODBC Driver 18 for SQL Server};server=lpc:localhost;database=recruitment_dw_dev_cd_v1;encrypt=yes;trustservercertificate=yes;\", \"SELECT CONCAT(j.build_id,'|',j.source_job_id) AS job_key,j.build_id,j.source,j.batch_id,j.source_job_id,j.title_raw,",
                "          CAST(j.analysis_date AS date) AS analysis_date,",
                "          COALESCE(NULLIF(j.category_raw,N''),N'未知') AS source_category_group,",
                "          q.experience_group AS experience_group,",
                "          q.education_group AS education_group,",
                "          j.is_core,j.body_valid,j.location_conflict,j.experience_conflict,j.education_conflict,",
                "          j.experience_hint,j.source_url,j.scope_reason,j.content_json,j.additional_requirements_raw,",
                "          j.issues_json,j.raw_ref,j.raw_sha256,j.body_hash_version,j.skill_text_scope",
                "          FROM (SELECT * FROM ads.cd_job_detail WHERE build_id IN (11,10)) j JOIN ads.release_job_detail q ON q.build_id=j.build_id AND q.observation_key=j.observation_key AND q.release_id=8\")"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "CityJobs",
        "columns": [
          {
            "name": "job_key",
            "dataType": "string",
            "lineageTag": "760a7f92-dac8-4d1a-bd6a-c0fc3fd90a31",
            "sourceColumn": "job_key",
            "summarizeBy": "none"
