            "dataType": "string",
            "lineageTag": "0ed07b6e-2642-4000-9a01-2e8abadbc6cb",
            "sourceColumn": "skill_b",
            "summarizeBy": "none"
          },
          {
            "name": "pair_label",
            "dataType": "string",
            "lineageTag": "d9485122-b9ed-4232-bf1f-dbe4d07858c1",
            "sourceColumn": "pair_label",
            "summarizeBy": "none"
          }
        ],
        "isHidden": true,
        "lineageTag": "bd18925b-2013-4d22-b98f-f3b738d2c52b",
        "partitions": [
          {
            "name": "Pairs",
            "mode": "import",
            "source": {
              "expression": [
                "let S = Odbc.Query(\"driver={ODBC Driver 18 for SQL Server};server=lpc:localhost;database=recruitment_dw_dev_cd_v1;encrypt=yes;trustservercertificate=yes;\", \"SELECT DISTINCT CONCAT(build_id,'|',source_job_id) AS job_key, skill_name",
                "      FROM ads.cd_skill_evidence",
                "      WHERE build_id IN (6,5) AND is_core=1 AND eligible_for_metric=1\"), A = Table.RenameColumns(S, {{\"skill_name\", \"skill_a\"}}), J = Table.NestedJoin(A, {\"job_key\"}, S, {\"job_key\"}, \"B\", JoinKind.Inner), E = Table.ExpandTableColumn(J, \"B\", {\"skill_name\"}, {\"skill_b\"}), F = Table.SelectRows(E, each Comparer.Ordinal([skill_a], [skill_b]) < 0), R = Table.AddColumn(F, \"pair_label\", each [skill_a] & \" + \" & [skill_b], type text) in R"
              ],
              "type": "m"
            }
          }
        ]
      },
