# Credentials and local environments
.env
.env.*
!.env.example
.venv/
.venv-dbt/
__pycache__/
*.pyc
.local/
.runtime/
# Formal collection batches under data/ are intentionally tracked.
# Legacy probe dumps and local runtime artifacts remain ignored.
research/**/raw/
research/**/samples.json
*.log
*.dump
*.sqlite
*.sqlite3
tmp/
~$*

# Local databases and backups are not collection batches
*.bak
*.mdf
*.ndf
*.ldf

# Generated dbt artifacts
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml

# Power BI project definitions are tracked; machine state and caches are local.
**/.pbi/localSettings.json
**/.pbi/cache.abf
**/.pbi/unappliedChanges.json
**/.pbi/RegisteredResources/
*.pbix
*.pbit
